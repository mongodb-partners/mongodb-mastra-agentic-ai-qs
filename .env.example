# Marshal — environment
APP_NAME=Marshal
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
MONGODB_DB=marshal
VOYAGE_API_KEY=
# Optional: leave COMMENTED OUT to use the MongoDB-hosted Voyage endpoint
# (https://ai.mongodb.com/v1). A blank `VOYAGE_BASE_URL=` is an empty string, not an absent value,
# and the default only applies when the variable is absent.
# VOYAGE_BASE_URL=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
# Provider credential, read by the AI SDK itself (not by src/config.ts). Set the one matching
# LLM_PROVIDER: ANTHROPIC_API_KEY, OPENAI_API_KEY, or the standard AWS chain for bedrock.
ANTHROPIC_API_KEY=
# Region for LLM_PROVIDER=bedrock; credentials come from the standard AWS provider chain
BEDROCK_REGION=
# Optional gateway routing for the LLM (Anthropic API root, e.g. .../anthropic/v1)
LLM_BASE_URL=
# Gateway key, sent as the `api-key` header when LLM_BASE_URL points at an API gateway
LLM_GATEWAY_API_KEY=
PORT=8000
# Synthetic decided-precedent corpus seeded at provision time (the scale story).
# 0 disables it; default 1200. Embedded in batches — ~13 Voyage calls at the default size.
SEED_SCALE_COUNT=1200
# Secrets (two, kept separate so neither can forge the other). A dev fallback is used only for
# non-production / demo runs, and only when the variable is ABSENT: a blank line here is an empty
# string, which is a third key that is neither the dev secret nor a real one. Comment these out to
# take the dev fallbacks. In production with the live agent, both MUST be set or startup fails.
AUDIT_SECRET=      # HMAC secret for the tamper-evident audit chain
SESSION_SECRET=    # HMAC secret for session tokens (distinct from AUDIT_SECRET)
# DEMO_MODE=1      # replay a pre-baked run (no runtime LLM); default off = live agent
# NODE_ENV=production
# UI defaults for every visitor. Both also take a per-visitor query override (?ui=, ?density=),
# and 'auto' means the same as empty: let the viewport pick.
# MARSHAL_UI=          # '' | auto | classic   — classic pins the fixed three-column layout
# MARSHAL_DENSITY=     # '' | auto | full | lean | minimal — on-screen copy density
